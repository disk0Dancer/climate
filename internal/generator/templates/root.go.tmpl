{{.ResolveDefaultBaseURL}}
}

func getConfigValue(key string) string {
	store, err := cfg.Load()
	if err != nil {
		return ""
	}
	value, ok, err := store.Get(key)
	if err != nil || !ok {
		return ""
	}
	return value
}


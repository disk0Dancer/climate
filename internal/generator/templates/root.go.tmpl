func getBaseURL() string {
	if baseURL != "" {
		return baseURL
	}
	if v := getConfigValue("core.base_url"); v != "" {
		return v
	}
	if v := os.Getenv({{printf "%q" .BaseURLEnv}}); v != "" {
		return v
	}
	return resolveDefaultBaseURL()
}


// Package secrets provides encrypted storage backends for CLI secrets so that
// values set via `config set --secret` (and `auth login`) are never written to
// config.json in plaintext.
package secrets

import (
	"bytes"
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"sort"
	"strings"
	"time"

	"filippo.io/age"
)

const (
	appName       = {{printf "%q" .CLIName}}
	envBackendVar = {{printf "%q" .EnvBackendVar}}
	gopassPrefix  = {{printf "%q" .GopassPrefix}}

	// BackendPlaintext keeps secrets inline in config.json (legacy escape hatch).
	BackendPlaintext = "plaintext"
	// BackendGopass stores secrets in the user's gopass password store.
	BackendGopass = "gopass"
	// BackendFile stores secrets in a local age-encrypted blob.
	BackendFile = "file"

	// gopassProbeTimeout bounds the auto-detection probe so a locked/misconfigured
	// gopass (e.g. a hung pinentry/GPG prompt) cannot stall every CLI invocation
	// during backend resolution.
	gopassProbeTimeout = 3 * time.Second
	// gopassOpTimeout bounds explicit secret operations; it is generous enough to
	// allow an interactive passphrase prompt while still guaranteeing the process
	// cannot hang forever.
	gopassOpTimeout = 2 * time.Minute
)

// Store abstracts encrypted secret storage keyed by profile and key.
type Store interface {
	Get(profile, key string) (string, bool, error)
	Set(profile, key, value string) error
	Unset(profile, key string) (bool, error)
	List(profile string) ([]string, error) // keys only, never values
	Name() string                          // backend id for diagnostics
}

// Resolve selects a secret backend using the documented order: an explicit
// environment override, then the persisted choice, then gopass if available,
// then the encrypted file fallback. A nil Store means the plaintext (legacy)
// backend and the caller keeps secrets inline in config.json. The returned
// name is always set.
func Resolve(persisted string) (Store, string, error) {
	hint := strings.TrimSpace(os.Getenv(envBackendVar))
	if hint == "" {
		hint = strings.TrimSpace(persisted)
	}
	if hint != "" {
		store, err := Open(hint)
		if err != nil {
			return nil, "", err
		}
		return store, hint, nil
	}
	if gopassUsable() {
		return newGopassStore(), BackendGopass, nil
	}
	store, err := newFileStore()
	if err != nil {
		return nil, "", err
	}
	return store, BackendFile, nil
}

// Open builds a specific backend by name without any auto-detection. A
// plaintext backend resolves to a nil Store.
func Open(name string) (Store, error) {
	switch strings.TrimSpace(name) {
	case BackendPlaintext:
		return nil, nil
	case BackendGopass:
		if !gopassUsable() {
			return nil, fmt.Errorf("secrets backend %q requested but gopass is not available or its store is not initialized", BackendGopass)
		}
		return newGopassStore(), nil
	case BackendFile:
		return newFileStore()
	default:
		return nil, fmt.Errorf("unknown secrets backend %q (expected gopass, file, or plaintext)", name)
	}
}

func configDir() (string, error) {
	dir, err := os.UserConfigDir()
	if err != nil {
		return "", fmt.Errorf("resolving user config dir: %w", err)
	}
	return filepath.Join(dir, appName), nil
}

// ---- gopass backend ----

type gopassStore struct{}

func newGopassStore() *gopassStore { return &gopassStore{} }

func (g *gopassStore) Name() string { return BackendGopass }

// runGopass runs the gopass binary with a timeout so a locked or misconfigured
// store (a hung pinentry/GPG prompt) cannot block the CLI indefinitely. It
// reports stdout, stderr, and whether the run exceeded the deadline.
func runGopass(timeout time.Duration, stdin string, args ...string) (stdout, stderr string, timedOut bool, err error) {
	ctx, cancel := context.WithTimeout(context.Background(), timeout)
	defer cancel()
	var out, errBuf bytes.Buffer
	cmd := exec.CommandContext(ctx, "gopass", args...)
	cmd.Env = os.Environ()
	cmd.Stdin = strings.NewReader(stdin)
	cmd.Stdout = &out
	cmd.Stderr = &errBuf
	runErr := cmd.Run()
	return out.String(), errBuf.String(), ctx.Err() == context.DeadlineExceeded, runErr
}

// gopassUsable reports whether a gopass binary is on PATH and its store is
// initialized (a bare `gopass ls --flat` succeeds within the probe timeout).
// A timeout is treated as "not usable" so resolution falls back to the file
// backend rather than hanging.
func gopassUsable() bool {
	if _, err := exec.LookPath("gopass"); err != nil {
		return false
	}
	_, _, _, err := runGopass(gopassProbeTimeout, "", "ls", "--flat")
	return err == nil
}

func (g *gopassStore) secretPath(profile, key string) string {
	return gopassPrefix + "/" + profile + "/" + key
}

func (g *gopassStore) Get(profile, key string) (string, bool, error) {
	stdout, stderr, timedOut, err := runGopass(gopassOpTimeout, "", "show", "-o", g.secretPath(profile, key))
	if err != nil {
		if timedOut {
			return "", false, fmt.Errorf("gopass show timed out after %s", gopassOpTimeout)
		}
		if isGopassNotFound(stderr) {
			return "", false, nil
		}
		return "", false, fmt.Errorf("gopass show: %w: %s", err, strings.TrimSpace(stderr))
	}
	return strings.TrimRight(stdout, "\r\n"), true, nil
}

func (g *gopassStore) Set(profile, key, value string) error {
	_, stderr, timedOut, err := runGopass(gopassOpTimeout, value, "insert", "-f", g.secretPath(profile, key))
	if err != nil {
		if timedOut {
			return fmt.Errorf("gopass insert timed out after %s", gopassOpTimeout)
		}
		return fmt.Errorf("gopass insert: %w: %s", err, strings.TrimSpace(stderr))
	}
	return nil
}

func (g *gopassStore) Unset(profile, key string) (bool, error) {
	_, stderr, timedOut, err := runGopass(gopassOpTimeout, "", "rm", "-f", g.secretPath(profile, key))
	if err != nil {
		if timedOut {
			return false, fmt.Errorf("gopass rm timed out after %s", gopassOpTimeout)
		}
		if isGopassNotFound(stderr) {
			return false, nil
		}
		return false, fmt.Errorf("gopass rm: %w: %s", err, strings.TrimSpace(stderr))
	}
	return true, nil
}

func (g *gopassStore) List(profile string) ([]string, error) {
	stdout, stderr, timedOut, err := runGopass(gopassOpTimeout, "", "ls", "--flat", gopassPrefix+"/"+profile)
	if err != nil {
		if timedOut {
			return nil, fmt.Errorf("gopass ls timed out after %s", gopassOpTimeout)
		}
		if isGopassNotFound(stderr) {
			return nil, nil
		}
		return nil, fmt.Errorf("gopass ls: %w: %s", err, strings.TrimSpace(stderr))
	}
	prefix := gopassPrefix + "/" + profile + "/"
	keys := []string{}
	for _, line := range strings.Split(stdout, "\n") {
		line = strings.TrimSpace(line)
		if line == "" {
			continue
		}
		keys = append(keys, strings.TrimPrefix(line, prefix))
	}
	sort.Strings(keys)
	return keys, nil
}

func isGopassNotFound(stderr string) bool {
	s := strings.ToLower(stderr)
	return strings.Contains(s, "not found") ||
		strings.Contains(s, "does not exist") ||
		strings.Contains(s, "not in the password store") ||
		strings.Contains(s, "no such")
}

// ---- encrypted file backend ----

type fileStore struct {
	identityPath string
	blobPath     string
}

func newFileStore() (*fileStore, error) {
	dir, err := configDir()
	if err != nil {
		return nil, err
	}
	return &fileStore{
		identityPath: filepath.Join(dir, "identity.age"),
		blobPath:     filepath.Join(dir, "secrets.age"),
	}, nil
}

func (f *fileStore) Name() string { return BackendFile }

// identity loads the age identity, generating and persisting one (mode 0600)
// on first use.
func (f *fileStore) identity() (*age.X25519Identity, error) {
	data, err := os.ReadFile(f.identityPath)
	if err == nil {
		id, perr := age.ParseX25519Identity(strings.TrimSpace(string(data)))
		if perr != nil {
			return nil, fmt.Errorf("parsing age identity: %w", perr)
		}
		return id, nil
	}
	if !errors.Is(err, os.ErrNotExist) {
		return nil, fmt.Errorf("reading age identity: %w", err)
	}
	id, gerr := age.GenerateX25519Identity()
	if gerr != nil {
		return nil, fmt.Errorf("generating age identity: %w", gerr)
	}
	if mkErr := os.MkdirAll(filepath.Dir(f.identityPath), 0o700); mkErr != nil {
		return nil, fmt.Errorf("creating config dir: %w", mkErr)
	}
	if wErr := os.WriteFile(f.identityPath, []byte(id.String()+"\n"), 0o600); wErr != nil {
		return nil, fmt.Errorf("writing age identity: %w", wErr)
	}
	return id, nil
}

func (f *fileStore) load() (map[string]map[string]string, *age.X25519Identity, error) {
	id, err := f.identity()
	if err != nil {
		return nil, nil, err
	}
	data, err := os.ReadFile(f.blobPath)
	if errors.Is(err, os.ErrNotExist) {
		return map[string]map[string]string{}, id, nil
	}
	if err != nil {
		return nil, nil, fmt.Errorf("reading secrets blob: %w", err)
	}
	r, err := age.Decrypt(bytes.NewReader(data), id)
	if err != nil {
		return nil, nil, fmt.Errorf("decrypting secrets: %w", err)
	}
	var buf bytes.Buffer
	if _, err := buf.ReadFrom(r); err != nil {
		return nil, nil, fmt.Errorf("reading decrypted secrets: %w", err)
	}
	out := map[string]map[string]string{}
	if buf.Len() > 0 {
		if err := json.Unmarshal(buf.Bytes(), &out); err != nil {
			return nil, nil, fmt.Errorf("parsing secrets: %w", err)
		}
	}
	if out == nil {
		out = map[string]map[string]string{}
	}
	return out, id, nil
}

func (f *fileStore) save(data map[string]map[string]string, id *age.X25519Identity) error {
	if err := os.MkdirAll(filepath.Dir(f.blobPath), 0o700); err != nil {
		return fmt.Errorf("creating config dir: %w", err)
	}
	plain, err := json.Marshal(data)
	if err != nil {
		return fmt.Errorf("serializing secrets: %w", err)
	}
	var buf bytes.Buffer
	w, err := age.Encrypt(&buf, id.Recipient())
	if err != nil {
		return fmt.Errorf("encrypting secrets: %w", err)
	}
	if _, err := w.Write(plain); err != nil {
		return fmt.Errorf("writing secrets: %w", err)
	}
	if err := w.Close(); err != nil {
		return fmt.Errorf("finalizing secrets: %w", err)
	}
	if err := os.WriteFile(f.blobPath, buf.Bytes(), 0o600); err != nil {
		return fmt.Errorf("writing secrets blob: %w", err)
	}
	return nil
}

func (f *fileStore) Get(profile, key string) (string, bool, error) {
	data, _, err := f.load()
	if err != nil {
		return "", false, err
	}
	if m, ok := data[profile]; ok {
		if v, ok := m[key]; ok {
			return v, true, nil
		}
	}
	return "", false, nil
}

func (f *fileStore) Set(profile, key, value string) error {
	data, id, err := f.load()
	if err != nil {
		return err
	}
	if data[profile] == nil {
		data[profile] = map[string]string{}
	}
	data[profile][key] = value
	return f.save(data, id)
}

func (f *fileStore) Unset(profile, key string) (bool, error) {
	data, id, err := f.load()
	if err != nil {
		return false, err
	}
	m, ok := data[profile]
	if !ok {
		return false, nil
	}
	if _, ok := m[key]; !ok {
		return false, nil
	}
	delete(m, key)
	if len(m) == 0 {
		delete(data, profile)
	}
	if err := f.save(data, id); err != nil {
		return false, err
	}
	return true, nil
}

func (f *fileStore) List(profile string) ([]string, error) {
	data, _, err := f.load()
	if err != nil {
		return nil, err
	}
	m := data[profile]
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys, nil
}
